{
  "name": "workspace-tools-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @moyarich/workspace-tools-playground",
    "build:playground": "npm run build -w @moyarich/workspace-tools-playground",
    "test": "vitest run",
    "build": "npm run build -w @moyarich/workspace-tools",
    "build:clis": "npm run build -w @moyarich/workspace-tools",
    "pack:check": "npm pack -w @moyarich/workspace-tools --dry-run"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1",
    "commander": "^15.0.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
